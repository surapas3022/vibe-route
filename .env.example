# Gemini: 768-d embeddings + chat fallback. Comma-separated keys rotate on quota.
GEMINI_API_KEY=key-one,key-two
# NVIDIA: 2048-d embeddings + primary chat. Same key is shared by embed and chat RPM.
NVIDIA_API_KEY=

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Dashboard → Settings → API Keys
# Secret key (sb_secret_...) goes to the backend only. Do not put it on the frontend.
SUPABASE_SECRET_KEY=
# Optional. Frontend does not talk to Supabase directly.
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated emails that become role=admin on register/login.
# Example: ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=

CORS_ORIGINS=http://localhost:5173,http://localhost,http://localhost:8080

POC_REGION=ภาคเหนือ
DATA_PATH=data/attraction.json
PORT=8000
